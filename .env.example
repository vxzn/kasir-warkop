# Salin berkas ini menjadi `.env` (berkas .env tidak ikut ke GitHub), lalu ganti nilainya.
# Docker Compose membaca `.env` otomatis. Tanpa `.env`, nilai bawaan pengembangan dipakai.

# Rahasia penandatangan token pengguna. Minimal 16 karakter; makin acak makin baik.
# Contoh membuat nilai acak:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter

# Kunci rahasia untuk komunikasi antar-layanan (pesanan <-> menu <-> pembayaran).
SERVICE_KEY=ganti-dengan-kunci-layanan-acak-minimal-32

# Kata sandi akun bawaan (dibuat hanya saat database auth masih kosong):
#   pemilik  -> peran pemilik (boleh melihat rekap penjualan)
#   kasir1   -> peran kasir
PEMILIK_PASSWORD=ganti-sandi-pemilik
KASIR_PASSWORD=ganti-sandi-kasir

# Lama sesi login (jam).
TOKEN_JAM=8

# Isi data penjualan CONTOH selama 60 hari terakhir agar rekap mingguan/bulanan tidak kosong
# saat demo. Ubah ke "true" hanya untuk presentasi. Jangan dipakai untuk data sungguhan.
DEMO_DATA=false
